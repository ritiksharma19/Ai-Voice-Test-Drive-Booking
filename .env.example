# ==============================================================================
# VoiceAgent — configuration
# Copy to .env and fill in only what you use. Never commit .env.
# Everything below has a sensible default; see README → Configuration.
# ==============================================================================

# ── 1. API keys (only for the providers you enable) ──────────────────────────
GEMINI_API_KEY=""          # https://aistudio.google.com/app/apikey
OPENAI_API_KEY=""          # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=""       # https://console.anthropic.com/settings/keys
SARVAM_API_KEY=""          # https://dashboard.sarvam.ai  (Indic TTS / STT)
ELEVENLABS_API_KEY=""      # https://elevenlabs.io/app/settings/api-keys
BRAVE_SEARCH_API_KEY=""    # https://api-dashboard.search.brave.com (optional, production web search)

# ── 2. LLM (the "brain") ─────────────────────────────────────────────────────
# gemini | openai | anthropic | ollama
LLM_PROVIDER="gemini"
# Tried in order if the primary errors or is slow to start answering:
LLM_FALLBACKS="openai,ollama"

GEMINI_MODEL="gemini-3.5-flash-lite"      # lowest latency; gemini-3.8-flash for higher quality
GEMINI_THINKING_LEVEL="minimal"           # minimal | low | medium | high  (3.8 Flash: low+)

OPENAI_MODEL="gpt-6-luna"                 # fast + cheap; gpt-6-sol for harder questions
OPENAI_REASONING_EFFORT="none"            # none = fastest first token
# OPENAI_BASE_URL=""                      # Azure OpenAI / vLLM / LM Studio (OpenAI-compatible)

ANTHROPIC_MODEL="claude-haiku-4-5"        # fastest Claude; claude-sonnet-5 for higher quality
# ANTHROPIC_THINKING="disabled"           # set for claude-sonnet-5 to minimise latency
# ANTHROPIC_EFFORT="low"                  # low | medium | high (Sonnet 5 / Opus 5 only)

OLLAMA_MODEL="gemma3:12b"                 # 8 GB VRAM: gemma3:4b · 16 GB+: gemma3:12b
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_KEEP_ALIVE="30m"                   # keep weights in VRAM between turns
# OLLAMA_THINK="false"                    # disable reasoning on thinking models (qwen3 …)

LLM_MAX_TOKENS="400"                      # spoken replies are short; caps runaway answers
LLM_TEMPERATURE="0.3"                     # Ollama only (cloud reasoning models ignore or reject it)
LLM_FIRST_TOKEN_TIMEOUT="6"               # seconds before failing over to the next provider
LLM_REQUEST_TIMEOUT="30"
LLM_MAX_RETRIES="1"
LLM_MAX_CONCURRENCY="32"                  # concurrent LLM streams across all users
HISTORY_TURNS="8"

# ── 3. Speech-to-text (the "ears") ───────────────────────────────────────────
# whisper  = faster-whisper on your NVIDIA GPU (CPU fallback)   [default]
# sarvam   = Sarvam Saaras v3, cloud, best for Indian languages / Hinglish
# openai   = OpenAI transcription, cloud
# seamless = AI4Bharat Indic-Seamless on GPU (pip install -r requirements-seamless.txt)
STT_PROVIDER="whisper"
WHISPER_MODEL=""                          # empty = large-v3-turbo on GPU, small on CPU
WHISPER_DEVICE="auto"                     # auto | cuda | cpu
WHISPER_COMPUTE_TYPE="auto"               # auto (float16 GPU / int8 CPU) | int8_float16 | ...
STT_LANGUAGE=""                           # force one language (e.g. hi) to skip language ID
STT_LANGUAGES="en,hi,ta,te,kn,ml,bn,mr,gu,pa"
SARVAM_STT_MODEL="saaras:v3"
OPENAI_STT_MODEL="gpt-4o-mini-transcribe"
SEAMLESS_MODEL="ai4bharat/indic-seamless"

# ── 4. Text-to-speech (the "voice") ──────────────────────────────────────────
# auto       = Sarvam for Indian languages (if SARVAM_API_KEY), Edge for English
# sarvam | openai | elevenlabs | edge   (Edge is always the fallback)
TTS_PROVIDER="auto"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_SPEAKER="priya"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="coral"
ELEVENLABS_MODEL="eleven_flash_v2_5"
ELEVENLABS_VOICE_ID=""
TTS_TIMEOUT="8"
TTS_MAX_CONCURRENCY="4"
TTS_FIRST_CHUNK_MIN_CHARS="24"            # first audio is cut at a clause after this many chars
TTS_FIRST_CHUNK_MAX_CHARS="70"            # …or at a word boundary at this length

# ── 5. Business (the dealership the agent represents) ────────────────────────
BUSINESS_NAME="Aurora Motors"
BUSINESS_CITY="Pune"
AGENT_NAME="Priya"                        # the assistant's spoken name
BUSINESS_TIMEZONE="Asia/Kolkata"
BUSINESS_HOURS="10:00-19:00"              # bookable slots end one slot before closing
BUSINESS_DAYS="mon,tue,wed,thu,fri,sat,sun"
SHOWROOMS="Baner Showroom;Viman Nagar Showroom"                 # separated by ;
CAR_MODELS="Aurora Pico,Aurora Sprint,Aurora Ridge,Aurora Ion"  # bookings are matched to these

# ── 6. Bookings (test drives + sales meetings) ───────────────────────────────
BOOKING_SLOT_MINUTES="60"
TEST_DRIVE_CAPACITY="2"                   # bookings per slot per showroom (cars available)
MEETING_CAPACITY="2"                      # bookings per slot per showroom (consultants)
BOOKING_MAX_DAYS_AHEAD="30"
BOOKING_MIN_LEAD_MINUTES="60"
BOOKING_DB_PATH="data/bookings.db"        # SQLite; git-ignored (contains phone numbers)
BOOKING_WEBHOOK_URL=""                    # optional: POST each new booking to a CRM / Zapier / Apps Script
ADMIN_TOKEN=""                            # set to enable GET /bookings (Authorization: Bearer <token>)

# ── 7. Knowledge base → Google fallback ──────────────────────────────────────
RETRIEVAL_MODE="auto"                     # auto | always | off
# auto = Discovery Engine if GCP_* is set, else the local Markdown files in KB_DIR
KB_PROVIDER="auto"                        # auto | local | discovery | off
KB_DIR="data/knowledge_base"
KB_MIN_COVERAGE="0.5"                     # share of query terms the KB must match to count as an answer
WEB_SEARCH_ENABLED="true"
# auto = Google (Gemini grounding, uses GEMINI_API_KEY) → Brave → free scrapers
WEB_SEARCH_PROVIDER="auto"                # auto | google | brave | scrape
GOOGLE_SEARCH_MODEL="gemini-3.5-flash-lite"
SEARCH_REGION="India"
LLM_RETRIEVAL_WAIT="3"                    # max seconds the answer waits for KB + web
RETRIEVAL_TIMEOUT="5"
RETRIEVAL_FILLER_AFTER="0.7"              # speak "let me check" if a web lookup takes longer
# Google Cloud Discovery Engine (pip install -r requirements-kb.txt). Leave empty to use the local KB.
# Auth: `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS=path\to\key.json
GCP_PROJECT_ID=""
GCP_LOCATION="global"
GCP_DATA_STORE_ID=""
KB_MULTILINGUAL="false"

# ── 8. Voice activity detection (VAD) ───────────────────────────────────────
VAD_SILENCE_MS="550"                      # end-of-speech pause: browser, and phone calls
# Phone calls stream raw audio, so the server finds the turns itself:
VAD_PROVIDER="silero"                     # silero (ONNX, bundled with faster-whisper) | energy
VAD_THRESHOLD="0.5"                       # speech probability per 32 ms frame; raise on noisy lines
VAD_MIN_SPEECH_MS="250"                   # speech needed to start a turn / interrupt the agent

# ── 9. Telephony: Exotel ─────────────────────────────────────────────────────
# Inbound: in your Exotel call flow, add a Voicebot applet with the URL
#   wss://your.domain/telephony/exotel?sample-rate=8000&token=<EXOTEL_WS_TOKEN>
EXOTEL_WS_TOKEN=""                        # shared secret for the stream (strongly recommended)
TELEPHONY_GREETING=""                     # empty = "Hello! This is <AGENT_NAME> from <BUSINESS_NAME>…" | off
TELEPHONY_LANGUAGE="en"                   # language of the greeting
# Outbound (POST /telephony/exotel/call, needs ADMIN_TOKEN): https://my.exotel.com → Settings → API
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.exotel.com"         # api.in.exotel.com for the Mumbai cluster
EXOTEL_CALLER_ID=""                       # your ExoPhone
EXOTEL_APP_ID=""                          # the call flow (app) that contains the Voicebot applet

# ── 10. Server ───────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
CORS_ORIGINS="*"                          # production: https://your.domain
MAX_AUDIO_SECONDS="30"
